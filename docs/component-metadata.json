          "type": "string | number | ReactNode",
          "required": false,
          "description": "Valor a mostrar"
        },
        {
          "name": "inline",
          "type": "boolean",
          "required": false,
          "defaultValue": "false",
          "description": "Si es true, muestra label y value en la misma línea"
        },
        {
          "name": "size",
          "type": "'sm' | 'md'",
          "required": false,
          "defaultValue": "md",
          "description": "Override local de tipografía. 'sm' baja un nivel completo (label = font-xs, value = font-sm). Útil para listas densas dentro de cards no-densas."
